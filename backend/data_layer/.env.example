# AegisRCA — Data Layer Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── MongoDB ────────────────────────────────────────────────────────────────────
# Connection string for the Atlas Local Docker container (see infra/mongodb/)
MONGODB_URI=mongodb://aegisrca:dev-only-change-this@localhost:27017/?authSource=admin&directConnection=true
MONGODB_DB_NAME=aegisrca

# ── Voyage AI ──────────────────────────────────────────────────────────────────
# Get your key from https://www.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_MODEL=voyage-multimodal-3.5
EMBEDDING_DIMENSIONS=1024

